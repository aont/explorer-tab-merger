CC ?= gcc
CFLAGS ?= -O2 -Wall -Wextra
CFLAGS += -std=c11
LDLIBS := -lole32 -loleaut32 -lshell32 -lshlwapi -luuid -luser32

TARGETS := merge_tabs.exe open_folder_tab.exe

.PHONY: all clean

all: $(TARGETS)

merge_tabs.exe: merge_tabs.c explorer_tabs.c explorer_tabs.h
	$(CC) $(CFLAGS) merge_tabs.c explorer_tabs.c -o $@ $(LDFLAGS) $(LDLIBS)

open_folder_tab.exe: open_folder_tab.c explorer_tabs.c explorer_tabs.h
	$(CC) $(CFLAGS) open_folder_tab.c explorer_tabs.c -o $@ $(LDFLAGS) $(LDLIBS)

clean:
	$(RM) $(TARGETS)
